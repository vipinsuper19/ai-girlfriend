      {
        "description": "create table \"messageReport\"",
        "sql": "CREATE TABLE \"public\".\"messageReport\" (\n  \"content\" text,\n  \"conversationId\" int4 NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"messageId\" int4 NOT NULL,\n  \"note\" text,\n  \"reason\" text NOT NULL,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"userId\" int4 NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"messageReport_reason_check_03d00617\" CHECK (\"reason\" IN ('HARMFUL', 'SEXUAL', 'HATE', 'INACCURATE', 'OTHER')),\n  CONSTRAINT \"messageReport_status_check_70734042\" CHECK (\"status\" IN ('PENDING', 'REVIEWED', 'DISMISSED'))\n)",
        "params": []
      }
    ],
    "postcheck": [
