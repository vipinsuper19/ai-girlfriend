# Copy to apps/api/.env. Values below are for local development.
# Lines marked SECRET are required in production and belong in the Render
# secret manager (dashboard env vars, Blueprint `sync: false`). Never commit
# real values. The full list is in the "Secret manager" section of README.md.

NODE_ENV=development
PORT=3001
# Comma-separated browser origins. Required. Not a credential, but per-deploy.
CORS_ORIGIN=http://localhost:3000
# Hops of trusted reverse proxy before the client IP. Render's proxy is 1.
TRUST_PROXY_HOPS=1

# SECRET. Supabase session pooler, port 5432 (*.pooler.supabase.com).
# Do not use the transaction pooler on port 6543.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_girlfriend
# SECRET in production. Migrations. Same session pooler. Falls back to
# DATABASE_URL outside production.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ai_girlfriend
# Optional. Not used by the API process today.
REDIS_URL=redis://localhost:6379

# SECRET. At least 32 characters each.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Optional SECRET. Falls back to a value derived from JWT_ACCESS_SECRET.
JWT_RESET_SECRET=
# Required in production (https). Reset links use this origin.
APP_URL=http://localhost:3000

# SECRET in production. Chat, embeddings, images, and (unless OpenAI is set)
# moderation.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_STT_MODEL=
GEMINI_TTS_MODEL=
GEMINI_IMAGE_MODEL=
# Optional SECRET. Used for moderation when MODERATION_PROVIDER=openai or auto.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=

# Moderation. Production refuses to boot if MODERATION_ENABLED=false or
# MODERATION_PROVIDER=local. `local` keeps the on-process rules and does not
# call Gemini or OpenAI. The emulator CI job sets it explicitly.
MODERATION_ENABLED=true
MODERATION_PROVIDER=auto

# Chat and embeddings. Unset or `gemini` uses GEMINI_API_KEY.
# `mock` returns a fixed reply and a fixed embedding and never calls a model
# API. Production boot rejects LLM_PROVIDER=mock. Leave this unset outside tests.
# LLM_PROVIDER=gemini
MODERATION_MODEL=
MODERATION_FAIL_CLOSED=true
CRISIS_HELPLINE_IN_NAME=Tele-MANAS
CRISIS_HELPLINE_IN_CONTACT=14416
CRISIS_HELPLINE_IN_DETAIL=24/7 mental health support in India
CRISIS_HELPLINE_INTL_NAME=International Association for Suicide Prevention
CRISIS_HELPLINE_INTL_CONTACT=https://www.iasp.info/suicidalthoughts/
CRISIS_HELPLINE_INTL_DETAIL=Find a local crisis line

# Free-tier chat cap. Blank keeps the default (day, 40 replies, 50000 tokens).
# `unlimited` removes that cap. `0` blocks new free-tier usage.
FREE_TIER_LLM_PERIOD=day
FREE_TIER_LLM_MESSAGE_LIMIT=40
FREE_TIER_LLM_TOKEN_LIMIT=50000

# Rate limits. A max of 0 turns that dimension off. Blank keeps the default.
# Windows are seconds.
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_LOGIN_IP_WINDOW_SEC=900
RATE_LIMIT_LOGIN_USER_MAX=10
RATE_LIMIT_LOGIN_USER_WINDOW_SEC=900
RATE_LIMIT_REGISTER_IP_MAX=10
RATE_LIMIT_REGISTER_IP_WINDOW_SEC=3600
RATE_LIMIT_REGISTER_USER_MAX=5
RATE_LIMIT_REGISTER_USER_WINDOW_SEC=3600
RATE_LIMIT_PASSWORD_RESET_IP_MAX=10
RATE_LIMIT_PASSWORD_RESET_IP_WINDOW_SEC=3600
RATE_LIMIT_PASSWORD_RESET_USER_MAX=5
RATE_LIMIT_PASSWORD_RESET_USER_WINDOW_SEC=3600
RATE_LIMIT_MESSAGES_IP_MAX=60
RATE_LIMIT_MESSAGES_IP_WINDOW_SEC=60
RATE_LIMIT_MESSAGES_USER_MAX=30
RATE_LIMIT_MESSAGES_USER_WINDOW_SEC=60

# local writes ./uploads and signs downloads with STORAGE_SIGNING_SECRET,
# or with JWT_ACCESS_SECRET when that is unset.
# s3 talks to any S3-compatible API. The Render deploy uses Supabase Storage.
# Production must be s3 (private Supabase Storage).
STORAGE_DRIVER=local
STORAGE_SIGNED_URL_TTL_SECONDS=3600
STORAGE_LOCAL_DIR=uploads
# Optional SECRET. Local download signatures fall back to JWT_ACCESS_SECRET.
STORAGE_SIGNING_SECRET=

# SECRET in production (the two keys). Endpoint shape:
# https://<project-ref>.storage.supabase.co/storage/v1/s3
# Region is the one shown next to that endpoint. Keep the bucket private.
# S3_FORCE_PATH_STYLE=true for Supabase, MinIO, and Backblaze B2.
# Set it to false only for AWS S3 virtual-hosted URLs.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-southeast-1
# S3_BUCKET=media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# MinIO from docker-compose, instead of the Supabase lines above:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=media
# S3_ACCESS_KEY_ID=minio
# S3_SECRET_ACCESS_KEY=minio-secret
# S3_FORCE_PATH_STYLE=true

# SECRET in production (SMTP_URL contains the mailbox password).
SMTP_URL=
MAIL_FROM=no-reply@example.com
# Optional. Public address and name on /privacy and /account-deletion.
# Until they are set, those pages show TODO.
CONTACT_EMAIL=
DEVELOPER_NAME=

# Optional. Google sign-in stays off until GOOGLE_CLIENT_IDS is set.
GOOGLE_CLIENT_IDS=
# Optional SECRET (the JSON). Push stays off until both are set.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional SECRET (the JSON). Play billing stays off until these are set.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_PRODUCTS=
