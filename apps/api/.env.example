# Copy to apps/api/.env. Values below are for local development.

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_girlfriend
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ai_girlfriend

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Optional. Falls back to a value derived from JWT_ACCESS_SECRET.
JWT_RESET_SECRET=
APP_URL=http://localhost:3000

# local writes ./uploads and signs downloads with STORAGE_SIGNING_SECRET,
# or with JWT_ACCESS_SECRET when that is unset.
# s3 talks to any S3-compatible API. The Render deploy uses Supabase Storage.
STORAGE_DRIVER=local
STORAGE_SIGNED_URL_TTL_SECONDS=3600
STORAGE_LOCAL_DIR=uploads
STORAGE_SIGNING_SECRET=

# Supabase Storage (private bucket): Storage → S3 in the project settings.
# Endpoint shape: https://<project-ref>.storage.supabase.co/storage/v1/s3
# Region is the one shown next to that endpoint.
# Same variables point at MinIO or Backblaze B2. Set S3_FORCE_PATH_STYLE=false
# only for AWS S3 virtual-hosted URLs.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-southeast-1
# S3_BUCKET=media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# MinIO from docker-compose, instead of the lines above:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=media
# S3_ACCESS_KEY_ID=minio
# S3_SECRET_ACCESS_KEY=minio-secret
# S3_FORCE_PATH_STYLE=true

SMTP_URL=
MAIL_FROM=
GOOGLE_CLIENT_IDS=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_STT_MODEL=
GEMINI_TTS_MODEL=
GEMINI_IMAGE_MODEL=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_PRODUCTS=
