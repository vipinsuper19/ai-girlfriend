# Dependencies
node_modules/

# PNPM
.pnpm-store/

# Build output
dist/
build/
.next/
out/
coverage/

# Turborepo local cache
.turbo/

# TypeScript incremental compilation cache
*.tsbuildinfo

# Compiled output emitted beside TypeScript sources.
# nest/tsc write emit to dist/; these patterns stop a stray in-source emit
# (JavaScript, source maps, declarations) from being committed next to .ts files.
# Hand-written scripts use .mjs. The Prisma schema contract is generated source
# and stays tracked.
apps/**/src/**/*.js
apps/**/src/**/*.js.map
apps/**/src/**/*.d.ts
apps/**/src/**/*.d.ts.map
packages/**/src/**/*.js
packages/**/src/**/*.js.map
packages/**/src/**/*.d.ts
packages/**/src/**/*.d.ts.map
!apps/api/src/prisma/contract.d.ts

# Environment files. Examples are tracked; real env files are not.
.env
.env.local
.env.development
.env.production
apps/*/.env

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.iml

# Android
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties

# Android keystore
*.jks
*.keystore

# Prisma
*.db
*.db-journal

# Sentry
.sentryclirc

# Safety held-out cases are scored from a path outside this repo.
**/*heldout*.json
**/*held-out*.json