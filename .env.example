# Local Docker Compose. Copy to `.env` in the repo root.
# These are development stand-ins. Production uses Supabase (see apps/api/.env.example)
# and does not read this file.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_girlfriend
POSTGRES_PORT=5432

REDIS_PORT=6379

# Private-bucket stand-in. The API talks to it only when STORAGE_DRIVER=s3.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=media
