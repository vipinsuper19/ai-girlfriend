# Docker Compose. Copy to `.env` in the repo root.
# The MinIO bucket is private. Point the API at it with the S3 variables in apps/api/.env.example.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_girlfriend
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=media
